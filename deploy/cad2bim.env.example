# Current Direct CAD/Data Compose foundation only.
# Copy outside the repository, set owner-only permissions, and replace every value.
CAD2BIM_ENV=production
CAD2BIM_POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
CAD2BIM_API_POSTGRES_PASSWORD=CHANGE_ME_DISTINCT_URL_SAFE_API_PASSWORD
CAD2BIM_RUNNER_POSTGRES_PASSWORD=CHANGE_ME_DISTINCT_URL_SAFE_RUNNER_PASSWORD
CAD2BIM_MCP_POSTGRES_PASSWORD=CHANGE_ME_DISTINCT_URL_SAFE_MCP_PASSWORD
CAD2BIM_DATA_QUERY_CURSOR_KEY=CHANGE_ME_BASE64URL_32_BYTE_CURSOR_KEY
CAD2BIM_MAX_UPLOAD_BYTES=104857600
